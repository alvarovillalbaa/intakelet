{
  "name": "@alvarovillalbaa/intakelet",
  "version": "0.3.0",
  "description": "Reviewed onboarding imports, source-backed knowledge and bounded website research",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24" },
  "exports": {
    ".": { "types": "./src/index.d.mts", "default": "./src/index.mjs" },
    "./element": { "types": "./src/element.d.mts", "default": "./src/element.mjs" },
    "./react": { "types": "./src/react.d.mts", "default": "./src/react.mjs" },
    "./node": { "types": "./src/node.d.mts", "default": "./src/node.mjs" },
    "./onboarding": { "types": "./src/onboarding-elements.d.mts", "default": "./src/onboarding-elements.mjs" },
    "./migration": { "types": "./src/migration-api.d.mts", "default": "./src/migration-api.mjs" },
    "./migration/node": { "types": "./src/migration-node.d.mts", "default": "./src/migration-node.mjs" },
    "./documents/node": { "types": "./src/document-node.d.mts", "default": "./src/document-node.mjs" },
    "./styles.css": "./src/element.css"
  },
  "bin": { "intakelet": "bin/intakelet.mjs" },
  "files": ["src/", "bin/", "examples/", "docs/specs/", "docs/references/", "README.md", "LICENSE"],
  "dependencies": { "ipaddr.js": "2.5.0", "parse5": "8.1.1", "robots-parser": "3.0.1", "pdfjs-dist": "6.5.438", "mammoth": "1.12.2", "exceljs": "4.4.0", "tesseract.js": "7.0.0" },
  "devDependencies": { "esbuild": "0.28.2", "@tesseract.js-data/eng": "1.0.0", "typescript": "5.9.3", "@types/node": "24.10.0" },
  "peerDependencies": { "react": "^18.3.1 || ^19.0.0" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "scripts": { "test": "node --test tests/unit/*.test.mjs", "check": "node scripts/check.mjs", "build": "node scripts/build.mjs" }
}
